{
  "name": "stillworks",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "The prompt-to-app studio that runs on your machine: multi-project registry, agent with sandboxed file tools, image generation, per-project Vite dev servers, live preview and real git history. Bring your own model key; nothing is hosted.",
  "author": "CodeWoxy",
  "company": "CodeWoxy",
  "productName": "Stillworks",
  "productId": "codewoxy-stillworks",
  "legacyProductNames": ["Lovable Local"],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aminahmad2009/lovable-clone.git"
  },
  "homepage": "https://github.com/aminahmad2009/lovable-clone#readme",
  "bugs": "https://github.com/aminahmad2009/lovable-clone/issues",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"tests/*.test.js\"",
    "desktop": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "version:check": "node build/check-version.mjs",
    "icons:build": "powershell -NoProfile -ExecutionPolicy Bypass -File build/make-icons.ps1 && node build/make-favicon-ico.mjs"
  },
  "engines": {
    "node": ">=20.10"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.codewoxy.stillworks",
    "productName": "Stillworks",
    "copyright": "Copyright © 2026 CodeWoxy",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "server/**/*",
      "web/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "README.md",
      "CHANGELOG.md",
      "docs/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "signtoolOptions": {
        "publisherName": "CodeWoxy"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stillworks"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "maintainer": "CodeWoxy",
      "icon": "build/icon.png"
    }
  }
}
